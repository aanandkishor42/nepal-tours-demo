# ---------------------------------------------------------------------------
# Copy this file to .env and edit the values. Never commit your real .env.
# ---------------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development

# Branding (shown all over the site, change these to your real company details)
COMPANY_NAME=Namaste Nepal Travels
COMPANY_TAGLINE=Your Himalayan Journey, Our Local Expertise
COMPANY_CITY=Kathmandu
COMPANY_ADDRESS=Bhagwan Bahal, Thamel, Kathmandu, Nepal
COMPANY_PHONE=+977 1 4700 125
COMPANY_WHATSAPP=9779800000000
COMPANY_EMAIL=hello@namastenepaltravels.com
COMPANY_LICENSE=Tourism License No. 12345 / Company Reg. No. 67890
GOOGLE_MAPS_EMBED=https://www.google.com/maps?q=Thamel,Kathmandu,Nepal&output=embed

# Money: how many Nepali Rupees equal 1 US Dollar (approximate, update as needed)
USD_RATE=133

# Admin panel: visit /admin and log in with this password
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=replace-with-a-long-random-string-in-production

# ---------------------------------------------------------------------------
# OPTIONAL notifications for new bookings (leave blank to disable)
# You can use one, two or all of these — they are independent.
# After editing .env, RESTART the server, then use the admin page's
# "Send test notification" button to confirm real delivery.
# ---------------------------------------------------------------------------

# WhatsApp option A: CallMeBot (free, easiest for personal numbers)
# 1. Save this number: +34 644 19 44 39  (or +1 469 344 0666)
# 2. WhatsApp them: "I allow callmebot to send me messages"
# 3. They reply with your API key — paste it below.
# Owner number is taken from COMPANY_WHATSAPP above.
WHATSAPP_CALLMEBOT_KEY=

# WhatsApp option B: Meta WhatsApp Cloud API (business account required)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp option C / Email option: any webhook URL (Make, Zapier, n8n, Slack…)
# We POST JSON with { type, text, booking, company } to this URL.
NOTIFICATION_WEBHOOK_URL=

# Email via SMTP (Gmail works with a 16-character App Password)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#        SMTP_PASS=your-app-password, OWNER_EMAIL=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OWNER_EMAIL=
